# Roast Judge environment. `npm run setup -- --seat N --key K` copies this file to .env and fills in
# SEAT and HONEYCOMB_API_KEY. `npm run dev` (and docker compose) read .env if it exists.

# Your seat number from the workshop handout (0-999). Your traces land in dataset roast-judge-<SEAT>.
SEAT=0
# Honeycomb ingest key for the workshop environment (from the handout). Never commit it.
HONEYCOMB_API_KEY=
# Honeycomb US ingest endpoint; the app appends /v1/traces.
HONEYCOMB_ENDPOINT=https://api.honeycomb.io
# Where spans go: otlp (Honeycomb), console (print to stdout) or memory (tests only).
ROASTJUDGE_EXPORTER=otlp
# The model-replay service the app talks to instead of a real LLM (OpenAI-compatible, served by npm run dev).
REPLAY_URL=http://localhost:4200/v1
# The pub-guide service the judge's tool calls (served by npm run dev).
PUB_GUIDE_URL=http://localhost:4100
# Model backend: replay (deterministic, free, the workshop default) or live (real OpenAI, needs OPENAI_API_KEY).
ROASTJUDGE_MODEL=replay
# Milliseconds between runs of the background load generator (npm run load).
LOAD_INTERVAL_MS=4000
# The replay model fails every Nth call with a 500, so there are errors to find. 0 turns that off.
REPLAY_FAIL_EVERY=25

# Honeycomb team slug of the shared workshop team (from the UI URL: ui.honeycomb.io/<team>/...).
# Same for every seat and not a secret; it lets `npm run first-trace` print a direct link to your trace.
HONEYCOMB_TEAM_SLUG=focusedlabs-4f
# Honeycomb environment slug of the workshop environment (ui.honeycomb.io/<team>/environments/<env>/...).
HONEYCOMB_ENV_SLUG=o11ydays-london

# Optional: uncomment and fill in as needed.
# A real OpenAI key, only used with ROASTJUDGE_MODEL=live (the load generator always uses replay).
# OPENAI_API_KEY=

# Set to true to copy prompts and completions onto chat spans (off by default: they can hold user data).
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
