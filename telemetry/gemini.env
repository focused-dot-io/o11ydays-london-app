# Gemini CLI telemetry for the Roast Judge workshop. Copy to .gemini/.env (gitignored) and fill in
# the two blanks from your seat card: <KEY> (ingest key) and <SEAT> (seat number).
# Gemini CLI loads .gemini/.env from the workspace when the folder is trusted.
# The endpoint (https://api.honeycomb.io) is set in .gemini/settings.json; these headers are
# read by the OpenTelemetry exporters Gemini CLI uses.
# Docs: https://github.com/google-gemini/gemini-cli/blob/main/docs/cli/telemetry.md
#       https://github.com/google-gemini/gemini-cli/blob/main/docs/reference/configuration.md
OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=<KEY>
OTEL_EXPORTER_OTLP_METRICS_HEADERS=x-honeycomb-team=<KEY>,x-honeycomb-dataset=agent-metrics
OTEL_RESOURCE_ATTRIBUTES=seat=<SEAT>
# logPrompts defaults to true in Gemini CLI. Keep prompt text out of the shared environment.
GEMINI_TELEMETRY_LOG_PROMPTS=false
