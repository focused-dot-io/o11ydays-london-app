# Antigravity CLI (agy) telemetry for the Roast Judge workshop. Copy to .agents/agy.env (gitignored)
# and fill in the two blanks from your seat card: <KEY> (ingest key) and <SEAT> (seat number).
# agy has no OpenTelemetry exporter of its own; telemetry/agy-hook.mjs, run from .agents/hooks.json
# (template: telemetry/agy-hooks.json), reads this file and sends one span per hook event.
# It never sends prompt text, tool arguments or tool output.
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=<KEY>
OTEL_RESOURCE_ATTRIBUTES=seat=<SEAT>
